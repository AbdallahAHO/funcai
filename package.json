{
  "name": "funcai",
  "version": "1.5.0",
  "description": "AI as a Function — structured AI output with typed providers, tracing, and retry",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.33.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "funcai": "./dist/bin/funcai.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./providers/lmstudio": {
      "import": {
        "types": "./dist/provider/lmstudio.d.ts",
        "default": "./dist/provider/lmstudio.js"
      },
      "require": {
        "types": "./dist/provider/lmstudio.d.cts",
        "default": "./dist/provider/lmstudio.cjs"
      }
    },
    "./providers/ollama": {
      "import": {
        "types": "./dist/provider/ollama.d.ts",
        "default": "./dist/provider/ollama.js"
      },
      "require": {
        "types": "./dist/provider/ollama.d.cts",
        "default": "./dist/provider/ollama.cjs"
      }
    },
    "./providers/openrouter": {
      "import": {
        "types": "./dist/provider/openrouter.d.ts",
        "default": "./dist/provider/openrouter.js"
      },
      "require": {
        "types": "./dist/provider/openrouter.d.cts",
        "default": "./dist/provider/openrouter.cjs"
      }
    },
    "./providers/cloudflare": {
      "import": {
        "types": "./dist/provider/cloudflare.d.ts",
        "default": "./dist/provider/cloudflare.js"
      },
      "require": {
        "types": "./dist/provider/cloudflare.d.cts",
        "default": "./dist/provider/cloudflare.cjs"
      }
    },
    "./trace/posthog": {
      "import": {
        "types": "./dist/trace/posthog.d.ts",
        "default": "./dist/trace/posthog.js"
      },
      "require": {
        "types": "./dist/trace/posthog.d.cts",
        "default": "./dist/trace/posthog.cjs"
      }
    },
    "./trace/langfuse": {
      "import": {
        "types": "./dist/trace/langfuse.d.ts",
        "default": "./dist/trace/langfuse.js"
      },
      "require": {
        "types": "./dist/trace/langfuse.d.cts",
        "default": "./dist/trace/langfuse.cjs"
      }
    },
    "./test": {
      "import": {
        "types": "./dist/test/index.d.ts",
        "default": "./dist/test/index.js"
      },
      "require": {
        "types": "./dist/test/index.d.cts",
        "default": "./dist/test/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src/provider/*/README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit -p tsconfig.type-tests.json",
    "examples:install": "tsx scripts/run.ts examples:install",
    "examples:typecheck": "tsx scripts/run.ts examples:typecheck",
    "examples:smoke": "tsx scripts/run.ts examples:smoke",
    "package:exports": "tsx scripts/run.ts package:exports",
    "package:smoke": "tsx scripts/package-smoke.ts",
    "package:check": "tsx scripts/run.ts package:check",
    "prepublishOnly": "pnpm build",
    "gate": "tsx scripts/run.ts gate",
    "maintenance:gate": "tsx scripts/run.ts maintenance:gate",
    "models:refresh": "tsx scripts/run.ts models:refresh",
    "models:report": "tsx scripts/model-registry-report.ts",
    "update:models": "tsx scripts/update-openrouter-models.ts",
    "update:cloudflare-models": "tsx scripts/update-cloudflare-models.ts",
    "langfuse:setup": "tsx scripts/setup-langfuse-models.ts",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@langfuse/otel": "^5.5.3",
    "@langfuse/tracing": "^5.5.3",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@posthog/ai": "^8.2.1",
    "posthog-node": "^5.38.2",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "peerDependenciesMeta": {
    "posthog-node": {
      "optional": true
    },
    "@posthog/ai": {
      "optional": true
    },
    "@langfuse/otel": {
      "optional": true
    },
    "@langfuse/tracing": {
      "optional": true
    },
    "@opentelemetry/sdk-node": {
      "optional": true
    }
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.1",
    "@clack/prompts": "^1.6.0",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "ai": "^7.0.4",
    "ai-gateway-provider": "^3.1.3",
    "ai-sdk-ollama": "^4.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@langfuse/otel": "^5.5.3",
    "@langfuse/tracing": "^5.5.3",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@posthog/ai": "^8.2.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "posthog-node": "^5.38.2",
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdallahAHO/funcai.git"
  },
  "homepage": "https://github.com/AbdallahAHO/funcai#readme",
  "keywords": [
    "ai",
    "llm",
    "structured-output",
    "zod",
    "typescript",
    "openrouter",
    "ai-sdk"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
